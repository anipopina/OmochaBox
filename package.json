{
  "name": "omochabox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build:test": "vite build --mode test",
    "test:home-visibility": "node tests/home-visibility.mjs",
    "test:home-button": "node tests/home-button.mjs",
    "test:stamp-boundaries": "node tests/stamp-pagination-boundaries.mjs",
    "test": "npm run test:smoke",
    "build:production": "npm run typecheck && vite build --mode aws",
    "preview:production": "vite preview --mode aws",
    "infra:synth": "npm run build:production && node infra/cli.mjs synth",
    "infra:diff": "npm run build:production && node infra/cli.mjs diff",
    "deploy:production": "npm run check && npm run build:production && node infra/cli.mjs deploy",
    "test:publication": "node --import tsx tests/publication.mjs",
    "test:infra": "node --import tsx tests/infrastructure.mjs",
    "test:toy": "node tests/run.mjs toy",
    "test:smoke": "node tests/run.mjs smoke",
    "test:full": "node tests/run.mjs full",
    "test:runner": "node --test tests/runner.test.mjs",
    "test:list": "node tests/run.mjs list"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "aws-cdk": "2.1146.1",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.187.0"
  }
}
